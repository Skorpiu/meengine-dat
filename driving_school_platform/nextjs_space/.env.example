# Copy to .env.local and replace placeholders. Never commit real values.
# Validated on check/build via lib/env.ts + scripts/env-check.ts

# --- Required ---

# NextAuth signing secret (use a long random string in real environments)
NEXTAUTH_SECRET=changeme-replace-with-long-random-string

# Prisma: Postgres connection URL (Supabase: Project Settings → Database)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public

# --- Optional (recommended for local NextAuth callbacks) ---

NEXTAUTH_URL=http://localhost:3000

# Prisma: direct DB URL when it differs from DATABASE_URL (e.g. Supabase pooler vs direct)
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public

# Public base URL for the app in the browser (only if you use it in client code)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional Supabase (Project Settings → API) ---

# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Optional demo (local only; production uses Vercel Environment Variables) ---
# Optional. Enables limited controlled writes for demo organizations only.
# DEMO_WRITE_SANDBOX_ENABLED=false

